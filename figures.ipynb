   "source": [
    "main_dir = \"/Users/kinga/Documents/my_scripts/all_ICSD_cifs/cifs\"\n",
    "\n",
    "cif_dir = Path(main_dir)\n",
    "results = []\n",
    "for cif_path in cif_dir.glob(\"*.cif\"):\n",
    "    \"\"\"Process a single CIF file and return its multi-oxidation elements.\"\"\"\n",
    "    try:\n",
    "        structure = Structure.from_file(cif_path)\n",
    "        element_oxi_dict = defaultdict(set)\n",
    "        multi_oxidation_elements = defaultdict(set)\n",
    "        for site in structure:\n",
    "            species = site.specie\n",
    "            if species.oxi_state is not None:\n",
    "                element_oxi_dict[species.element].add(species.oxi_state)\n",
    "\n",
    "        multi_oxidation_elements = {\n",
    "            el: ox_states\n",
    "            for el, ox_states in element_oxi_dict.items()\n",
    "            if len(ox_states) > 1\n",
    "        }\n",
    "\n",
    "        results.append([cif_path.stem, multi_oxidation_elements])\n",
    "    except Exception as e:\n",
    "        pass\n",
    "\n",
    "\n",
    "# with ProcessPoolExecutor(max_workers=1) as executor:\n",
    "#     results.append(executor.submit(process_cif, main_dir))"
   ]
