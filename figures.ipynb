   "source": [
    "import multiprocessing\n",
    "from concurrent.futures import ProcessPoolExecutor\n",
    "import concurrent.futures\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "from tqdm import tqdm\n",
    "import logging\n",
    "import gc\n",
    "\n",
    "# Set up logging\n",
    "logging.basicConfig(level=logging.INFO)\n",
    "logger = logging.getLogger(__name__)\n",
    "\n",
    "\n",
    "def process_cif(cif_path):\n",
    "    \"\"\"Process a single CIF file and return its multi-oxidation elements.\"\"\"\n",
    "    try:\n",
    "        # Clear memory from previous runs\n",
    "        gc.collect()\n",
    "\n",
    "        structure = Structure.from_file(cif_path)\n",
    "        element_oxi_dict = defaultdict(set)\n",
    "\n",
    "        for site in structure:\n",
    "            species = site.specie\n",
    "            if species.oxi_state is not None:\n",
    "                element_oxi_dict[species.element].add(species.oxi_state)\n",
    "\n",
    "        multi_oxidation_elements = {\n",
    "            el: ox_states\n",
    "            for el, ox_states in element_oxi_dict.items()\n",
    "            if len(ox_states) > 1\n",
    "        }\n",
    "\n",
    "        # Clean up\n",
    "        del structure\n",
    "        gc.collect()\n",
    "\n",
    "        return cif_path.stem, (\n",
    "            multi_oxidation_elements if multi_oxidation_elements else None\n",
    "        )\n",
    "    except Exception as e:\n",
    "        logger.error(f\"Error processing {cif_path}: {str(e)}\")\n",
    "        return cif_path.stem, f\"Error: {str(e)}\"\n",
    "\n",
    "\n",
    "def analyze_cifs(main_dir):\n",
    "    \"\"\"Analyze CIF files in parallel with progress tracking.\"\"\"\n",
    "    cif_dir = Path(main_dir)\n",
    "    cif_files = list(cif_dir.glob(\"*.cif\"))\n",
    "    results = {}\n",
    "\n",
    "    # Use fewer workers to reduce memory pressure\n",
    "    n_workers = max(1, min(multiprocessing.cpu_count() - 2, len(cif_files), 4))\n",
    "    logger.info(f\"Using {n_workers} workers\")\n",
    "\n",
    "    # Process files in smaller batches\n",
    "    batch_size = 100\n",
    "    for i in range(0, len(cif_files), batch_size):\n",
    "        batch = cif_files[i : i + batch_size]\n",
    "\n",
    "        with ProcessPoolExecutor(max_workers=n_workers) as executor:\n",
    "            with tqdm(\n",
    "                total=len(batch),\n",
    "                desc=f\"Processing batch {i//batch_size + 1}/{len(cif_files)//batch_size + 1}\",\n",
    "            ) as pbar:\n",
    "\n",
    "                futures = {\n",
    "                    executor.submit(process_cif, cif_path): cif_path\n",
    "                    for cif_path in batch\n",
    "                }\n",
    "\n",
    "                for future in concurrent.futures.as_completed(futures):\n",
    "                    try:\n",
    "                        cif_name, result = future.result()\n",
    "                        if result:\n",
    "                            results[cif_name] = result\n",
    "                        pbar.update(1)\n",
    "                    except Exception as e:\n",
    "                        logger.error(f\"Task failed: {str(e)}\")\n",
    "                        pbar.update(1)\n",
    "\n",
    "        # Clear memory between batches\n",
    "        gc.collect()\n",
    "\n",
    "    return results\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    try:\n",
    "        main_dir = \"/Users/kinga/Documents/my_scripts/all_ICSD_cifs/cifs\"\n",
    "        results = analyze_cifs(main_dir)\n",
    "\n",
    "        print(f\"\\nProcessed {len(results)} files with multiple oxidation states:\")\n",
    "        for cif_name, elements in results.items():\n",
    "            if isinstance(elements, dict):\n",
    "                print(f\"\\nCIF: {cif_name}\")\n",
    "                for element, states in elements.items():\n",
    "                    print(f\"  {element.symbol}: {sorted(states)}\")\n",
    "            else:\n",
    "                print(f\"\\nCIF: {cif_name}\\n  {elements}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        logger.error(f\"Analysis failed: {str(e)}\")"
   ]
  },
