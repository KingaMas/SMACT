    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "from collections import Counter\n",
    "\n",
    "\n",
    "# Create co-occurrence matrix\n",
    "def create_cooccurrence_matrix(keys_list):\n",
    "    # Get unique elements\n",
    "    all_elements = df_elements[0].to_list()\n",
    "    n_elements = len(all_elements)\n",
    "\n",
    "    # Create empty matrix\n",
    "    matrix = np.zeros((n_elements, n_elements))\n",
    "    element_to_idx = {el: i for i, el in enumerate(all_elements)}\n",
    "\n",
    "    # Fill matrix with co-occurrences\n",
    "    for atom in single_series.index:\n",
    "        print(f\"Atom is {(atom)}\")\n",
    "        try:\n",
    "            i = element_to_idx[str(atom)]\n",
    "        except KeyError:\n",
    "            print(f\"KeyError: {atom}\")\n",
    "            continue\n",
    "    for count in single_series.values:\n",
    "        print(f\"Count is {count}\")\n",
    "        matrix[i, i] += count\n",
    "\n",
    "    return pd.DataFrame(matrix, index=all_elements, columns=all_elements)\n",
    "\n",
    "\n",
    "# Create visualization\n",
    "def plot_element_heatmap(cooccurrence_df):\n",
    "    plt.figure(figsize=(12, 10))\n",
    "\n",
    "    # Create heatmap\n",
    "    sns.heatmap(\n",
    "        cooccurrence_df,\n",
    "        cmap=\"YlOrRd\",\n",
    "        square=True,\n",
    "        annot=True,\n",
    "        fmt=\".0f\",\n",
    "        cbar_kws={\"label\": \"Co-occurrence count\"},\n",
    "    )\n",
    "\n",
    "    plt.title(\"Element Co-occurrence in Compounds\")\n",
    "    plt.xlabel(\"Elements\")\n",
    "    plt.ylabel(\"Elements\")\n",
    "    plt.tight_layout()\n",
    "\n",
    "    return plt\n",
    "\n",
    "\n",
    "# # Use your existing filtered data\n",
    "# keys = [list(i.keys()) for i in list_el]\n",
    "\n",
    "# Create and plot matrix\n",
    "cooccurrence_matrix = create_cooccurrence_matrix(keys)\n",
    "plot = plot_element_heatmap(cooccurrence_matrix)\n",
    "plot.show()\n",
    "\n",
    "# Optional: Save the plot\n",
    "plt.savefig(\"element_cooccurrence.png\", dpi=300, bbox_inches=\"tight\")"
   ]
  },
